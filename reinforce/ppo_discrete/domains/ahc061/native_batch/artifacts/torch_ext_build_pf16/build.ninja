ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=ahc061_reinforce_native_cpp_pf16_v1 -DTORCH_API_INCLUDE_EXTENSION_H -I/home/nanoseeing/AtCoder/atcoder-repository/AHC/AHC061/reinforce/ppo_discrete/domains/ahc061/native_batch/cpp_core/include -isystem /home/nanoseeing/.pyenv/versions/3.11.4/lib/python3.11/site-packages/torch/include -isystem /home/nanoseeing/.pyenv/versions/3.11.4/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/nanoseeing/.pyenv/versions/3.11.4/include/python3.11 -fPIC -std=c++17 -O3 -march=native -std=c++20 -DNDEBUG -DAHC061_PF_PARTICLES=16
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/nanoseeing/.pyenv/versions/3.11.4/lib/python3.11/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build ahc061_ext.o: compile /home/nanoseeing/AtCoder/atcoder-repository/AHC/AHC061/reinforce/ppo_discrete/domains/ahc061/native_batch/cpp_ext/src/ahc061_ext.cpp





build ahc061_reinforce_native_cpp_pf16_v1.so: link ahc061_ext.o

default ahc061_reinforce_native_cpp_pf16_v1.so
